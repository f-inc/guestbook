LUMA_API_KEY=replace_with_your_luma_calendar_api_key
DB_URL=postgresql://user:password@localhost:5432/guestbook
LUMA_DEFAULT_TIMEZONE=America/Los_Angeles

# Required by the browser UI and every Guestbook API route.
GUESTBOOK_KEY=replace_with_private_guestbook_key

# Optional but recommended for cron/job callers in production.
GUESTBOOK_SYNC_SECRET=replace_with_random_sync_secret

# Conservative safety defaults for large calendars. Raise intentionally.
LUMA_MAX_EVENTS=25
LUMA_EVENTS_PAGE_SIZE=25
LUMA_MAX_EVENT_PAGES=1
LUMA_EVENTS_CACHE_SECONDS=300
# Database-backed calendar metadata only; guest lists are not included.
LUMA_INDEX_MAX_EVENTS=5000
LUMA_MAX_GUESTS_PER_EVENT=250
LUMA_GUESTS_PAGE_SIZE=100
LUMA_MAX_GUEST_PAGES_PER_EVENT=3
LUMA_GUEST_CACHE_SECONDS=600
LUMA_EVENT_SYNC_MAX_GUESTS=50000
LUMA_EVENT_SYNC_GUESTS_PAGE_SIZE=100
LUMA_EVENT_SYNC_MAX_GUEST_PAGES=1000
LUMA_EVENT_SYNC_REQUEST_DELAY_MS=200
LUMA_TRACE_MAX_EVENTS=250
LUMA_TRACE_EVENTS_PAGE_SIZE=50
LUMA_TRACE_MAX_EVENT_PAGES=5
LUMA_TRACE_REQUEST_DELAY_MS=325
LUMA_TRACE_CACHE_SECONDS=900
LUMA_INDEX_TRACE_MAX_RECORDS=500
LUMA_REFRESH_MAX_EVENTS=250
LUMA_REFRESH_EVENTS_PAGE_SIZE=50
LUMA_REFRESH_MAX_EVENT_PAGES=5
LUMA_REFRESH_MAX_GUESTS_PER_EVENT=50000
LUMA_REFRESH_GUESTS_PAGE_SIZE=100
LUMA_REFRESH_MAX_GUEST_PAGES_PER_EVENT=1000
LUMA_REFRESH_REQUEST_DELAY_MS=325
LUMA_SYNC_MAX_EVENTS=250
LUMA_SYNC_EVENTS_PAGE_SIZE=50
LUMA_SYNC_MAX_EVENT_PAGES=10
LUMA_SYNC_MAX_GUESTS_PER_EVENT=1000
LUMA_SYNC_GUESTS_PAGE_SIZE=100
LUMA_SYNC_MAX_GUEST_PAGES_PER_EVENT=10
LUMA_SYNC_STALE_AFTER_MINUTES=60
LUMA_SYNC_REQUEST_DELAY_MS=350
LUMA_MAX_INVITES_PER_REQUEST=50
DB_TRANSACTION_TIMEOUT_MS=30000
DB_SYNC_GUEST_WRITE_CHUNK_SIZE=250

# Local redacted endpoint debug log. Keep this file out of git.
GUESTBOOK_DEBUG_LOG_PATH=.debug/luma-api.log
