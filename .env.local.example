LUMA_API_KEY=replace_with_your_luma_calendar_api_key
# Optional additional public API keys are discovered numerically.
# LUMA_API_KEY_2=replace_with_another_luma_calendar_api_key

# Optional signed-in manager sessions. These add hosted events that are not
# visible to the public API keys. Numbered tokens are aggregated the same way.
# LUMA_SESSION_TOKEN=replace_with_luma_auth_session_cookie_value
# LUMA_SESSION_TOKEN_2=replace_with_another_luma_auth_session_cookie_value

# Signing secret from Calendar Settings → Developer → Webhooks. Configure the
# webhook to send guest.registered and guest.updated to /api/luma/webhooks.
LUMA_WEBHOOK_SECRET=whsec_replace_with_luma_webhook_secret
# Optional additional calendar webhook secrets are discovered numerically.
# LUMA_WEBHOOK_SECRET_2=whsec_replace_with_another_webhook_secret
# Reject signed deliveries older than this replay window (60-3600 seconds).
LUMA_WEBHOOK_TOLERANCE_SECONDS=300
# Direct/session connection to the same database as DB_URL, never transaction pooling.
# DB_NOTIFY_URL=postgresql://user:password@database.example:5432/guestbook
# DB_NOTIFY_CA_CERT=server_certificate_authority_pem
# The secret, API key and calendar mapping must share the same numbered suffix.
# LUMA_WEBHOOK_CALENDAR_ID=cal_example

DB_URL=postgresql://user:password@localhost:5432/guestbook
# Optional runtime override. Supabase session-pooler DB_URL values are automatically
# routed through transaction mode (port 6543 with pgbouncer=true) at runtime.
# For a private namespace, retain schema=guestbook and URL-encoded startup options
# for -c search_path=guestbook,pg_catalog so pooled resets preserve raw SQL routing.
DB_RUNTIME_URL=
# Set to session only for a deliberately persistent Supabase runtime.
DB_RUNTIME_POOL_MODE=transaction
LUMA_DEFAULT_TIMEZONE=America/Los_Angeles

# Required by the browser UI and every Guestbook API route.
GUESTBOOK_KEY=replace_with_private_guestbook_key

# Optional but recommended for cron/job callers in production.
GUESTBOOK_SYNC_SECRET=replace_with_random_sync_secret

# Conservative safety defaults for large calendars. Raise intentionally.
LUMA_MAX_EVENTS=25
LUMA_EVENTS_PAGE_SIZE=25
LUMA_MAX_EVENT_PAGES=1
LUMA_EVENTS_CACHE_SECONDS=300
# Database-backed calendar metadata only; guest lists are not included.
LUMA_INDEX_MAX_EVENTS=5000
LUMA_MAX_GUESTS_PER_EVENT=250
LUMA_GUESTS_PAGE_SIZE=100
LUMA_MAX_GUEST_PAGES_PER_EVENT=3
LUMA_GUEST_CACHE_SECONDS=600
LUMA_EVENT_SYNC_MAX_GUESTS=50000
LUMA_EVENT_SYNC_GUESTS_PAGE_SIZE=100
LUMA_EVENT_SYNC_MAX_GUEST_PAGES=1000
LUMA_EVENT_SYNC_REQUEST_DELAY_MS=200
LUMA_TRACE_MAX_EVENTS=250
LUMA_TRACE_EVENTS_PAGE_SIZE=50
LUMA_TRACE_MAX_EVENT_PAGES=5
LUMA_TRACE_REQUEST_DELAY_MS=325
LUMA_TRACE_CACHE_SECONDS=900
LUMA_INDEX_TRACE_MAX_RECORDS=500
LUMA_REFRESH_MAX_EVENTS=250
LUMA_REFRESH_EVENTS_PAGE_SIZE=50
LUMA_REFRESH_MAX_EVENT_PAGES=5
LUMA_REFRESH_MAX_GUESTS_PER_EVENT=50000
LUMA_REFRESH_GUESTS_PAGE_SIZE=100
LUMA_REFRESH_MAX_GUEST_PAGES_PER_EVENT=1000
LUMA_REFRESH_REQUEST_DELAY_MS=325
LUMA_EVENT_CATALOG_MAX_EVENTS=500
LUMA_EVENT_CATALOG_MAX_PAGES=100
LUMA_SYNC_MAX_EVENTS=250
LUMA_SYNC_EVENTS_PAGE_SIZE=50
LUMA_SYNC_MAX_EVENT_PAGES=10
LUMA_SYNC_MAX_GUESTS_PER_EVENT=1000
LUMA_SYNC_GUESTS_PAGE_SIZE=100
LUMA_SYNC_MAX_GUEST_PAGES_PER_EVENT=10
LUMA_SYNC_STALE_AFTER_MINUTES=60
LUMA_SYNC_REQUEST_DELAY_MS=350
LUMA_MAX_INVITES_PER_REQUEST=50
LUMA_MAX_BULK_STATUS_UPDATES=50
LUMA_BULK_STATUS_REQUEST_DELAY_MS=100
# Maximum signed-in Luma survey responses returned for one event.
LUMA_FEEDBACK_MAX_RESPONSES=1000
LUMA_FEEDBACK_MAX_EVENTS=50
LUMA_FEEDBACK_CONCURRENCY=3
DB_TRANSACTION_TIMEOUT_MS=30000
DB_SYNC_GUEST_WRITE_CHUNK_SIZE=250
DB_CONNECTION_LIMIT=2
DB_POOL_TIMEOUT_SECONDS=20
AUTOMATIC_TAG_EVENT_SETTLE_MINUTES=360
AUTOMATIC_TAG_TRANSACTION_TIMEOUT_MS=120000

# Local redacted endpoint debug log. Keep this file out of git.
GUESTBOOK_DEBUG_LOG_PATH=.debug/luma-api.log

# Server-only Campus integration key; requires form-submissions.read.
CAMPUS_API_KEY=
CAMPUS_API_URL=https://api.f.inc
# Server-only trusted-server header matching the Campus API firewall rule.
API_FIREWALL_BYPASS_KEY=

# Keep legacy until the separately reviewed human migration/backfill is verified.
# Set human on every writer only during the coordinated cutover in docs/human-identity.md.
GUESTBOOK_IDENTITY_MODE=legacy
# Bound explicit per-account activity refreshes across the human's known events.
LUMA_TRACE_MAX_LOOKUPS=250

# Optional coordinated migration. Leave disabled until capture is installed and
# every deployed request/worker supports the same reviewed handoff identity.
DB_HANDOFF_ENABLED=false
DB_HANDOFF_MIGRATION_ID=
DB_DESTINATION_URL=
DB_DESTINATION_RUNTIME_URL=
DB_DESTINATION_NOTIFY_URL=
DB_DESTINATION_NOTIFY_CA_CERT=
