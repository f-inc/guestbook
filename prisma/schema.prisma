generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model LumaEvent {
  eventId     String    @id @map("event_id")
  title       String
  date        DateTime? @db.Date
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  visibility  String?
  location    String?
  category    String?
  capacity    Int?
  lumaUrl     String?   @map("luma_url")
  catalogActive Boolean @default(true) @map("catalog_active")
  overviewStats Json    @default("{}") @map("overview_stats")
  overviewStatsUpdatedAt DateTime? @map("overview_stats_updated_at") @db.Timestamptz(6)
  feedbackAverageRating Float?    @map("feedback_average_rating")
  feedbackRatingCount   Int       @default(0) @map("feedback_rating_count")
  feedbackStatsUpdatedAt DateTime? @map("feedback_stats_updated_at") @db.Timestamptz(6)
  raw         Json      @default("{}")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  syncedAt    DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  guests             LumaEventGuest[]
  syncState          LumaEventSyncState?
  manualTagMutations ManualTagMutation[]

  @@index([startsAt(sort: Desc)])
  @@index([catalogActive, startsAt(sort: Desc)])
  @@index([visibility, startsAt(sort: Desc)])
  @@map("luma_events")
}

model LumaPerson {
  personId          String    @id @map("person_id")
  lumaUserId        String?   @map("luma_user_id")
  lumaUserIdLower   String?   @map("luma_user_id_lower")
  email             String?
  emailLower        String?   @map("email_lower")
  phoneNumber       String?   @map("phone_number")
  name              String
  title             String?
  bio               String?
  avatarUrl         String?   @map("avatar_url")
  profileUrl        String?   @map("profile_url")
  socialLinks       Json      @default("[]") @map("social_links")
  referrer          Json?
  groups            Json      @default("[]")
  tags              Json      @default("[]")
  manualTags        Json      @default("[]") @map("manual_tags")
  automaticTags     Json      @default("[]") @map("automatic_tags")
  raw               Json      @default("{}")
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  eventGuests         LumaEventGuest[]
  comments            GuestComment[]
  automaticTagMatches AutomaticTagAssignment[]
  manualTagMutations  ManualTagMutation[]

  @@index([lumaUserIdLower])
  @@index([emailLower])
  @@map("luma_people")
}

model GuestComment {
  id        BigInt     @id @default(autoincrement())
  personId  String     @map("person_id")
  body      String     @db.Text
  author    String     @default("Guestbook")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  person    LumaPerson @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@index([personId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("guest_comments")
}

model GuestTag {
  id          String   @id
  name        String
  color       String   @default("#0f766e")
  managed     Boolean  @default(false)
  ruleKey     String?  @unique @map("rule_key")
  semanticKey String?  @unique @map("semantic_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  automaticAssignments AutomaticTagAssignment[]
  manualMutations      ManualTagMutation[]

  @@map("guest_tags")
}

model SuperTag {
  id        String         @id
  name      String
  color     String         @default("#38bdf8")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  rules     SuperTagRule[]

  @@map("super_tags")
}

model SuperTagRule {
  id         BigInt   @id @default(autoincrement())
  superTagId String   @map("super_tag_id")
  source     String
  phrase     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  superTag   SuperTag @relation(fields: [superTagId], references: [id], onDelete: Cascade)

  @@index([superTagId])
  @@map("super_tag_rules")
}

model ManualTagMutation {
  id              BigInt    @id @default(autoincrement())
  personId        String    @map("person_id")
  tagId           String    @map("tag_id")
  assignedAt      DateTime? @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedEventId String?   @map("assigned_event_id")
  removed         Boolean   @default(false)

  person        LumaPerson @relation(fields: [personId], references: [personId], onDelete: Cascade)
  tag           GuestTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedEvent LumaEvent? @relation(fields: [assignedEventId], references: [eventId], onDelete: SetNull)

  @@index([personId, tagId, assignedAt(sort: Desc), id(sort: Desc)])
  @@index([assignedEventId, tagId, assignedAt(sort: Desc)])
  @@index([tagId, assignedAt(sort: Desc)])
  @@map("manual_tag_mutations")
}

model AutomaticTagAssignment {
  personId    String   @map("person_id")
  tagId       String   @map("tag_id")
  ruleKey     String   @map("rule_key")
  evidence    Json     @default("{}")
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  evaluatedAt DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  person LumaPerson @relation(fields: [personId], references: [personId], onDelete: Cascade)
  tag    GuestTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, ruleKey])
  @@index([tagId, personId])
  @@index([personId])
  @@map("automatic_tag_assignments")
}

model AutomaticTagState {
  id                     String   @id
  publicEventFingerprint String   @default("") @map("public_event_fingerprint")
  lastMode               String?  @map("last_mode")
  lastEvaluatedCount     Int      @default(0) @map("last_evaluated_count")
  lastChangedCount       Int      @default(0) @map("last_changed_count")
  lastDurationMs         Int      @default(0) @map("last_duration_ms")
  lastRunAt              DateTime @default(now()) @map("last_run_at") @db.Timestamptz(6)

  @@map("automatic_tag_state")
}

model LumaEventGuest {
  eventId             String    @map("event_id")
  personId            String    @map("person_id")
  lumaGuestId         String?   @map("luma_guest_id")
  lumaUserId          String?   @map("luma_user_id")
  lumaUserIdLower     String?   @map("luma_user_id_lower")
  email               String?
  emailLower          String?   @map("email_lower")
  phoneNumber         String?   @map("phone_number")
  status              String?
  lumaApprovalStatus  String?   @map("luma_approval_status")
  operatorDecision    String?   @map("operator_decision")
  isReferred          Boolean   @default(false) @map("is_referred")
  isNewReferral       Boolean   @default(false) @map("is_new_referral")
  hasPriorEvent       Boolean   @default(false) @map("has_prior_event")
  metricsDerivedAt    DateTime? @map("metrics_derived_at") @db.Timestamptz(6)
  registeredAt        DateTime? @map("registered_at") @db.Timestamptz(6)
  invitedAt           DateTime? @map("invited_at") @db.Timestamptz(6)
  createdAt           DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @map("updated_at") @db.Timestamptz(6)
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  checkedInAt         DateTime? @map("checked_in_at") @db.Timestamptz(6)
  profileDescription  String?   @map("profile_description")
  registrationAnswers Json      @default("[]") @map("registration_answers")
  socialLinks         Json      @default("[]") @map("social_links")
  referrer            Json?
  searchText          String?   @map("search_text")
  raw                 Json      @default("{}")
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  syncedAt            DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  event  LumaEvent  @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  person LumaPerson @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@id([eventId, personId])
  @@index([eventId])
  @@index([eventId, status, operatorDecision])
  @@index([eventId, hasPriorEvent])
  @@index([eventId, isReferred, isNewReferral])
  @@index([personId])
  @@index([lumaUserIdLower])
  @@index([emailLower])
  @@index([personId, checkedInAt(sort: Desc), registeredAt(sort: Desc), createdAt(sort: Desc), lastSeenAt(sort: Desc)], map: "luma_event_guests_person_activity_idx")
  @@index([lumaUserIdLower, checkedInAt(sort: Desc), registeredAt(sort: Desc), createdAt(sort: Desc), lastSeenAt(sort: Desc)], map: "luma_event_guests_luma_user_activity_idx")
  @@index([emailLower, checkedInAt(sort: Desc), registeredAt(sort: Desc), createdAt(sort: Desc), lastSeenAt(sort: Desc)], map: "luma_event_guests_email_activity_idx")
  @@index([checkedInAt(sort: Desc), registeredAt(sort: Desc), createdAt(sort: Desc), lastSeenAt(sort: Desc)])
  @@map("luma_event_guests")
}

model LumaSyncRun {
  id          String    @id @default(cuid())
  requestId   String    @map("request_id")
  status      String
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  eventCount  Int       @default(0) @map("event_count")
  guestCount  Int       @default(0) @map("guest_count")
  personCount Int       @default(0) @map("person_count")
  error       String?
  limits      Json      @default("{}")

  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@map("luma_sync_runs")
}

model LumaEventSyncState {
  eventId         String    @id @map("event_id")
  lastGuestSyncAt DateTime? @map("last_guest_sync_at") @db.Timestamptz(6)
  lastEventSyncAt DateTime? @map("last_event_sync_at") @db.Timestamptz(6)
  lastWebhookAt   DateTime? @map("last_webhook_at") @db.Timestamptz(6)
  lastWebhookId   String?   @map("last_webhook_id")
  lastGuestCount  Int       @default(0) @map("last_guest_count")
  lastStatus      String?   @map("last_status")
  truncated       Boolean   @default(false)
  error           String?
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  event LumaEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@index([lastGuestSyncAt(sort: Desc)])
  @@index([lastStatus])
  @@map("luma_event_sync_state")
}

model LumaWebhookDelivery {
  webhookId     String    @id @map("webhook_id")
  webhookType   String    @map("webhook_type")
  eventId       String?   @map("event_id")
  guestId       String?   @map("guest_id")
  payloadSha256 String    @map("payload_sha256")
  status        String
  attempts      Int       @default(1)
  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  error         String?
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, updatedAt(sort: Asc)])
  @@index([eventId, receivedAt(sort: Desc)])
  @@map("luma_webhook_deliveries")
}

// Bulk invitation evidence and optional email timelines; RSVP remains on LumaEventGuest.
model LumaInviteTracking {
  eventId       String
  emailLower    String
  personId      String?
  lumaUserId    String?
  name          String?
  eventTitle    String?
  status        String   @default("unknown")
  messages      Json     @default("[]")
  issueMessages Json     @default("[]")
  bulkInvite    Json     @default("{}")
  bulkCheckedAt DateTime? @db.Timestamptz(6)
  checkedAt     DateTime? @db.Timestamptz(6)
  requestedAt   DateTime? @db.Timestamptz(6)
  nextCheckAt   DateTime? @default(now()) @db.Timestamptz(6)
  priority      Int @default(0)
  retryCount    Int @default(0)
  lastError     String?
  issueReason   String?
  removedAt     DateTime? @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  @@id([eventId, emailLower])
  @@index([status, checkedAt])
  @@index([nextCheckAt, priority])
  @@index([emailLower])
  @@map("luma_invite_tracking")
}

model LumaInviteAttempt {
  id          String @id @default(cuid())
  batchId     String
  eventId     String
  emailLower  String
  status      String @default("processing")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  @@index([eventId, createdAt])
  @@index([batchId])
  @@map("luma_invite_attempts")
}

// Shared worker lease, credential pause, and resumable explicit event backfills.
model LumaTrackingState {
  key String @id
  leaseUntil DateTime? @db.Timestamptz(6)
  owner String?
  cursor String?
  active Boolean @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@map("luma_tracking_state")
}

model LumaCalendarOptOut {
  calendarId String
  emailLower String
  observedAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([calendarId, emailLower])
  @@map("luma_calendar_opt_outs")
}

model EmailAddress {
  emailLower String @id
  personId String?
  name String?
  state String @default("unchecked")
  reason String?
  score Int?
  flags Json @default("{}")
  checkedAt DateTime? @db.Timestamptz(6)
  queuedRunId String?
  @@index([queuedRunId, emailLower])
  @@index([state, emailLower])
  lumaBlockedReason String?
  lumaBlockedAt DateTime? @db.Timestamptz(6)
  lumaCheckedAt DateTime? @db.Timestamptz(6)
  lumaClearedAt DateTime? @db.Timestamptz(6)
  checks EmailVerificationCheck[]
  @@map("email_addresses")
}

model EmailVerificationCheck {
  id String @id
  emailLower String
  address EmailAddress @relation(fields: [emailLower], references: [emailLower])
  provider String
  providerBatchId String?
  state String
  reason String?
  score Int?
  flags Json
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([emailLower, checkedAt])
  @@map("email_verification_checks")
}

model EmailVerificationRun {
  id String @id
  status String @default("running")
  total Int @default(0)
  processed Int @default(0)
  skipped Int @default(0)
  eventIds Json @default("[]")
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  lockUntil DateTime? @db.Timestamptz(6)
  nextCheckAt DateTime @default(now()) @db.Timestamptz(6)
  error String?
  @@map("email_verification_runs")
}

model EmailVerificationBatch {
  id String @id
  runId String
  providerId String?
  status String @default("submitting")
  emails Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([runId, status])
  @@map("email_verification_batches")
}

// Durable cleanup ledger, independent of contact sync and verification refreshes.
model EmailRemovalJob {
  id String @id
  status String @default("draft")
  calendars Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  confirmedAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  items EmailRemovalItem[]
  inactive EmailInactive[]
  @@map("email_removal_jobs")
}
model EmailRemovalItem {
  jobId String
  job EmailRemovalJob @relation(fields: [jobId], references: [id])
  emailLower String
  calendarId String
  name String?
  reason String
  status String @default("pending")
  attemptId String?
  startedAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  error String?
  @@id([jobId, emailLower, calendarId])
  @@index([status, jobId], map: "email_removal_work")
  @@index([emailLower, status], map: "email_removal_email")
  @@map("email_removal_items")
}
model EmailInactive {
  emailLower String @id
  inactiveAt DateTime @default(now()) @db.Timestamptz(6)
  jobId String
  job EmailRemovalJob @relation(fields: [jobId], references: [id])
  @@map("email_inactive")
}
